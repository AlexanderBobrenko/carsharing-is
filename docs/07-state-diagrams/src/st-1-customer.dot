digraph G {
  rankdir=TB; nodesep=0.7; ranksep=0.85; pad=0.3; dpi=130; splines=true;
  node [fontname="Liberation Sans", fontsize=13, shape=box, style="rounded,filled", fillcolor="#e8f0fb", color="#1f3a5f", penwidth=1.5, margin="0.25,0.14"];
  edge [fontname="Liberation Sans", fontsize=11, color="#333333", arrowsize=0.9];
  __start [shape=circle, label="", width=0.25, style=filled, fillcolor=black, color=black];
  __end [shape=doublecircle, label="", width=0.22, style=filled, fillcolor=black, color=black];
  "Зарегистрирован";
  "На проверке";
  "Ожидает ручной проверки";
  "Подтверждён";
  "Отклонён";
  "Заблокирован";
  "Удалён";
  __start -> "Зарегистрирован" [label=" клиент подал заявку "];
  "Зарегистрирован" -> "На проверке" [label=" документы загружены\n[возраст ≥ 21 и стаж ≥ 2 лет] "];
  "Зарегистрирован" -> "Отклонён" [label=" документы загружены\n[возраст < 21 или стаж < 2 лет] "];
  "На проверке" -> "Подтверждён" [label=" проверка успешна,\nдоговор принят "];
  "На проверке" -> "Ожидает ручной проверки" [label=" результат проверки\nнеоднозначен "];
  "Ожидает ручной проверки" -> "Подтверждён" [label=" менеджер подтвердил\nдокументы, договор принят "];
  "Ожидает ручной проверки" -> "Отклонён" [label=" менеджер отклонил\nдокументы "];
  "Отклонён" -> "На проверке" [label=" подан исправленный\nкомплект документов "];
  "Подтверждён" -> "Заблокирован" [label=" менеджер заблокировал\nклиента "];
  "Заблокирован" -> "Подтверждён" [label=" менеджер снял\nблокировку "];
  "Подтверждён" -> "Удалён" [label=" клиент удалил аккаунт\n[нет аренды и долга] "];
  "Удалён" -> __end;
}
digraph G {
  rankdir=LR; nodesep=0.7; ranksep=0.85; pad=0.3; dpi=130; splines=true;
  node [fontname="Liberation Sans", fontsize=13, shape=box, style="rounded,filled", fillcolor="#e8f0fb", color="#1f3a5f", penwidth=1.5, margin="0.25,0.14"];
  edge [fontname="Liberation Sans", fontsize=11, color="#333333", arrowsize=0.9];
  __start [shape=circle, label="", width=0.25, style=filled, fillcolor=black, color=black];
  __end [shape=doublecircle, label="", width=0.22, style=filled, fillcolor=black, color=black];
  "Активна";
  "Переведена в аренду";
  "Отменена";
  __start -> "Активна" [label=" клиент создал бронь\n[клиент допущен, авто свободно] "];
  "Активна" -> "Переведена в аренду" [label=" клиент начал аренду "];
  "Активна" -> "Переведена в аренду" [label=" истекли 15 минут "];
  "Активна" -> "Отменена" [label=" клиент отменил\n[аренда не начата] "];
  "Переведена в аренду" -> __end;
  "Отменена" -> __end;
}
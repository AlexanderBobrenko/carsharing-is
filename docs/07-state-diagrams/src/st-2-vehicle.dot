digraph G {
  rankdir=TB; nodesep=0.7; ranksep=0.85; pad=0.3; dpi=130; splines=true;
  node [fontname="Liberation Sans", fontsize=13, shape=box, style="rounded,filled", fillcolor="#e8f0fb", color="#1f3a5f", penwidth=1.5, margin="0.25,0.14"];
  edge [fontname="Liberation Sans", fontsize=11, color="#333333", arrowsize=0.9];
  __start [shape=circle, label="", width=0.25, style=filled, fillcolor=black, color=black];
  __end [shape=doublecircle, label="", width=0.22, style=filled, fillcolor=black, color=black];
  "Свободен";
  "Забронирован";
  "В аренде";
  "На обслуживании";
  "Недоступен";
  "Списан";
  __start -> "Свободен" [label=" добавлен администратором\n[телематика подключена] "];
  "Свободен" -> "Забронирован" [label=" бронь создана "];
  "Забронирован" -> "Свободен" [label=" бронь отменена "];
  "Забронирован" -> "В аренде" [label=" аренда начата "];
  "В аренде" -> "Свободен" [label=" аренда завершена\n[замечаний нет] "];
  "В аренде" -> "На обслуживании" [label=" аренда завершена\n[топливо < 10%, салон загрязнён,\nповреждения или авто вне зоны] "];
  "В аренде" -> "Недоступен" [label=" аренда закрыта менеджером\n[зарегистрировано ДТП] "];
  "Недоступен" -> "На обслуживании" [label=" создана заявка\nна обслуживание "];
  "Свободен" -> "На обслуживании" [label=" создана заявка на\nплановое обслуживание "];
  "Свободен" -> "Недоступен" [label=" потеряна связь\nс телематикой "];
  "Недоступен" -> "Свободен" [label=" связь восстановлена\n[нет открытых заявок] "];
  "На обслуживании" -> "Свободен" [label=" техник подтвердил\n[автомобиль исправен] "];
  "Свободен" -> "Списан" [label=" списан администратором "];
  "Недоступен" -> "Списан" [label=" списан администратором "];
  "Списан" -> __end;
}
digraph G {
  rankdir=TB; nodesep=0.55; ranksep=0.9; pad=0.3; dpi=120; splines=true; newrank=true;
  node [shape=plain, fontname="Liberation Sans", fontsize=11];
  edge [fontname="Liberation Sans", fontsize=10, color="#333333", arrowsize=0.9, labelfontsize=10];
  Money [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#f3ecff" cellpadding="5">«value object»<br/><b>Money</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- amount: Decimal<br/>- currency: String</td></tr><tr><td align="left" balign="left" cellpadding="4"> </td></tr></table>>];
  Passport [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#f3ecff" cellpadding="5">«value object»<br/><b>Passport</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- series: String<br/>- number: String</td></tr><tr><td align="left" balign="left" cellpadding="4"> </td></tr></table>>];
  DrivingLicense [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#f3ecff" cellpadding="5">«value object»<br/><b>DrivingLicense</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- number: String<br/>- category: String<br/>- expiresOn: Date</td></tr><tr><td align="left" balign="left" cellpadding="4"> </td></tr></table>>];
  Customer [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Customer</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- fullName: String<br/>- phone: String<br/>- birthDate: Date<br/>- drivingExperienceYears: Integer<br/>- status: CustomerStatus</td></tr><tr><td align="left" balign="left" cellpadding="4">+ submitDocuments()<br/>+ confirm()<br/>+ reject(reason)<br/>+ block()<br/>+ canBook(): Boolean</td></tr></table>>];
  Contract [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Contract</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- acceptedAt: DateTime<br/>- version: String</td></tr><tr><td align="left" balign="left" cellpadding="4">+ accept()</td></tr></table>>];
  Employee [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Employee</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- fullName: String<br/>- isActive: Boolean</td></tr><tr><td align="left" balign="left" cellpadding="4"> </td></tr></table>>];
  Manager [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Manager</b></td></tr><tr><td align="left" balign="left" cellpadding="4"> </td></tr><tr><td align="left" balign="left" cellpadding="4">+ verifyDocuments()<br/>+ decideIncident()<br/>+ issueCharge()<br/>+ resolveSupportRequest()</td></tr></table>>];
  Technician [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Technician</b></td></tr><tr><td align="left" balign="left" cellpadding="4"> </td></tr><tr><td align="left" balign="left" cellpadding="4">+ performService()<br/>+ inspectAfterRental()</td></tr></table>>];
  Administrator [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Administrator</b></td></tr><tr><td align="left" balign="left" cellpadding="4"> </td></tr><tr><td align="left" balign="left" cellpadding="4">+ manageFleet()<br/>+ setTariff()</td></tr></table>>];
  ServiceZone [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>ServiceZone</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- name: String</td></tr><tr><td align="left" balign="left" cellpadding="4">+ contains(location): Boolean</td></tr></table>>];
  Vehicle [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Vehicle</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- plateNumber: String<br/>- model: String<br/>- fuelLevel: Integer<br/>- status: VehicleStatus</td></tr><tr><td align="left" balign="left" cellpadding="4">+ reserve()<br/>+ release()<br/>+ sendToService()<br/>+ markAvailable()<br/>+ decommission()</td></tr></table>>];
  Tariff [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Tariff</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- name: String<br/>- driveRate: Money<br/>- waitRate: Money<br/>- dayRate: Money</td></tr><tr><td align="left" balign="left" cellpadding="4"> </td></tr></table>>];
  Booking [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Booking</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- createdAt: DateTime<br/>- expiresAt: DateTime<br/>- status: BookingStatus</td></tr><tr><td align="left" balign="left" cellpadding="4">+ cancel()<br/>+ convertToRental()</td></tr></table>>];
  Rental [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Rental</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- startedAt: DateTime<br/>- finishedAt: DateTime<br/>- status: RentalStatus</td></tr><tr><td align="left" balign="left" cellpadding="4">+ start()<br/>+ finish()<br/>+ close()<br/>+ calculateCost(): Money</td></tr></table>>];
  Inspection [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Inspection</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- type: InspectionType<br/>- performedAt: DateTime<br/>- photos: List&lt;Photo&gt;<br/>- damages: String</td></tr><tr><td align="left" balign="left" cellpadding="4"> </td></tr></table>>];
  Payment [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Payment</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- amount: Money<br/>- type: PaymentType<br/>- status: PaymentStatus</td></tr><tr><td align="left" balign="left" cellpadding="4">+ execute()<br/>+ release()</td></tr></table>>];
  Charge [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Charge</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- type: ChargeType<br/>- amount: Money<br/>- reason: String<br/>- evidence: List&lt;Photo&gt;<br/>- status: ChargeStatus</td></tr><tr><td align="left" balign="left" cellpadding="4">+ contest()<br/>+ cancel()</td></tr></table>>];
  Incident [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>Incident</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- type: IncidentType<br/>- occurredAt: DateTime<br/>- clientAtFault: Boolean<br/>- status: IncidentStatus</td></tr><tr><td align="left" balign="left" cellpadding="4">+ registerEvidence()<br/>+ calculateClientShare(): Money<br/>+ close()</td></tr></table>>];
  ServiceRequest [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>ServiceRequest</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- reason: ServiceReason<br/>- status: ServiceRequestStatus</td></tr><tr><td align="left" balign="left" cellpadding="4">+ assign(technician)<br/>+ complete()</td></tr></table>>];
  SupportRequest [label=<<table border="0" cellborder="1" cellspacing="0" color="#1f3a5f"><tr><td bgcolor="#e8f0fb" cellpadding="5"><b>SupportRequest</b></td></tr><tr><td align="left" balign="left" cellpadding="4">- topic: SupportTopic<br/>- text: String<br/>- status: SupportRequestStatus</td></tr><tr><td align="left" balign="left" cellpadding="4">+ resolve(decision)</td></tr></table>>];
  Customer -> Passport [dir=both, arrowtail=diamond, arrowhead=none, label=" имеет ", taillabel="1", headlabel="1", labeldistance=2.2];
  Customer -> DrivingLicense [dir=both, arrowtail=diamond, arrowhead=none, label=" имеет ", taillabel="1", headlabel="1", labeldistance=2.2];
  Customer -> Contract [arrowhead=vee, label=" принимает ", taillabel="1", headlabel="0..*", labeldistance=2.2];
  Customer -> Booking [arrowhead=vee, label=" создаёт ", taillabel="1", headlabel="0..*", labeldistance=2.2];
  Customer -> SupportRequest [arrowhead=vee, label=" подаёт ", taillabel="1", headlabel="0..*", labeldistance=2.2];
  Manager -> Employee [arrowhead=empty, color="#1f3a5f", penwidth=1.4];
  Technician -> Employee [arrowhead=empty, color="#1f3a5f", penwidth=1.4];
  Administrator -> Employee [arrowhead=empty, color="#1f3a5f", penwidth=1.4];
  ServiceZone -> Vehicle [dir=both, arrowtail=odiamond, arrowhead=none, label=" включает ", taillabel="1", headlabel="0..*", labeldistance=2.2];
  Booking -> Vehicle [arrowhead=vee, label=" резервирует ", taillabel="0..*", headlabel="1", labeldistance=2.2];
  Booking -> Tariff [arrowhead=vee, label=" по тарифу ", taillabel="0..*", headlabel="1", labeldistance=2.2];
  Booking -> Rental [arrowhead=vee, label=" становится ", taillabel="1", headlabel="0..1", labeldistance=2.2];
  Rental -> Inspection [dir=both, arrowtail=diamond, arrowhead=none, label=" включает ", taillabel="1", headlabel="1..2", labeldistance=2.2];
  Rental -> Payment [arrowhead=vee, label=" оплачивается ", taillabel="1", headlabel="0..*", labeldistance=2.2];
  Rental -> Charge [arrowhead=vee, label=" порождает ", taillabel="1", headlabel="0..*", labeldistance=2.2];
  Rental -> Incident [arrowhead=vee, label=" связана с ", taillabel="1", headlabel="0..*", labeldistance=2.2];
  Vehicle -> ServiceRequest [arrowhead=vee, label=" требует ", taillabel="1", headlabel="0..*", labeldistance=2.2];
  Technician -> ServiceRequest [arrowhead=vee, label=" выполняет ", taillabel="1", headlabel="0..*", labeldistance=2.2];
  SupportRequest -> Charge [arrowhead=vee, label=" оспаривает ", taillabel="0..*", headlabel="0..1", labeldistance=2.2];
  Manager -> SupportRequest [arrowhead=vee, label=" рассматривает ", taillabel="1", headlabel="0..*", labeldistance=2.2];
  Manager -> Incident [arrowhead=vee, label=" обрабатывает ", taillabel="1", headlabel="0..*", labeldistance=2.2];
  n1 [shape=note, label="{возраст ≥ 21 года;\nстаж ≥ 2 лет}", fontname="Liberation Sans", fontsize=10, style=filled, fillcolor="#fff8c4", color="#8a6d1d"];
  n1 -> Customer [style=dashed, arrowhead=none, color="#8a6d1d"];
  n2 [shape=note, label="{expiresAt = createdAt\n+ 15 минут}", fontname="Liberation Sans", fontsize=10, style=filled, fillcolor="#fff8c4", color="#8a6d1d"];
  n2 -> Booking [style=dashed, arrowhead=none, color="#8a6d1d"];
  n3 [shape=note, label="{удержание на время\nаренды = 5 000 ₽}", fontname="Liberation Sans", fontsize=10, style=filled, fillcolor="#fff8c4", color="#8a6d1d"];
  n3 -> Payment [style=dashed, arrowhead=none, color="#8a6d1d"];
  n4 [shape=note, label="{у клиента не более одной\nактивной брони или аренды}", fontname="Liberation Sans", fontsize=10, style=filled, fillcolor="#fff8c4", color="#8a6d1d"];
  n4 -> Rental [style=dashed, arrowhead=none, color="#8a6d1d"];
  { rank=same; Money; Tariff; }
}
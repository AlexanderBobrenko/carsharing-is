@startuml ad03-maintenance
' AD-03 Обслуживание — Задание №3, Щербова А.А.
' UC-16, UC-18, UC-14, UC-15
title AD-03 — Заявка на обслуживание: назначение, выполнение, статус

skinparam shadowing false
skinparam activity {
  BackgroundColor white
  BorderColor #1a1a1a
  ArrowColor #333333
}
skinparam partition {
  BackgroundColor #f7f9fc
  BorderColor #1a1a1a
}
skinparam title {
  FontSize 16
  FontStyle bold
}

start
partition "Администратор" {
  :Выявление нужды в обслуживании;
  note right
    Пробег и ТО-план, сигнал
    телематики, жалоба,
    инцидент из AD-02
  end note
  :Создание заявки, назначение техника (UC-18);
}
partition "Система" {
  :Уведомление техника, фиксация срока;
  :Авто — на обслуживании, скрыто с карты;
}
partition "Техник" {
  :Приём заявки (UC-14);
  :Осмотр авто;
  if (Ремонт вне компетенции?) then (да)
    :Эскалация администратору;
  else (нет)
    :Выполнение: мойка, заправка, ТО;
    note right
      Железо телематики готовое,
      не разрабатываем
    end note
    :Отчёт о выполнении;
  endif
}
partition "Администратор" {
  if (Заявка требует внешнего сервиса?) then (да)
    :Вывод авто в недоступен, внешний ремонт;
    stop
  else (нет)
  endif
  :Проверка результата;
  if (Принято?) then (да)
  else (нет)
    :Возврат на доработку;
    :Доработка техником, повторная проверка — принята;
    note right
      Цикл «доработка-проверка»
      показан свернуто
    end note
  endif
}
partition "Система" {
  :Смена статуса UC-15: свободно / недоступен;
}
partition "Телематика" {
  :Подтверждение статуса, гео и топливо;
}
partition "Система" {
  :Закрытие заявки, учёт в отчётах (UC-19);
}
stop

footer Задание №3 • Щербова А.А. • UC-14,15,18 • Vision v1.1
@enduml

@startuml ad01-rental
' AD-01 Аренда автомобиля — Задание №3, Щербова А.А.
' UC-02, UC-03, UC-04, UC-05, UC-06 (+06a,06b), UC-07
title AD-01 — Аренда: поиск, бронь, начало, завершение, оплата

skinparam shadowing false
skinparam activity {
  BackgroundColor white
  BorderColor #1a1a1a
  ArrowColor #333333
}
skinparam partition {
  BackgroundColor #f7f9fc
  BorderColor #1a1a1a
}
skinparam title {
  FontSize 16
  FontStyle bold
}

start
partition "Клиент" {
  :Поиск свободных авто на карте, фильтрация (UC-02);
  note right
    Телематика даёт гео, топливо, статус.
    Фильтры: класс, топливо, расстояние
  end note
  if (Подходящее авто найдено?) then (да)
  else (нет)
    :Смена фильтров / конец поиска;
    stop
  endif
  :Бронирование авто (UC-03);
  note right
    15 мин бесплатно,
    далее — ожидание 4 руб/мин
  end note
}
partition "Система" {
  if (Клиент начал аренду за 15 мин?) then (да)
  else (нет)
    if (Удерживать авто платно?) then (да)
      :Начисление ожидания 4 руб/мин;
    else (нет)
      :Снятие брони, авто снова свободно;
      stop
    endif
  endif
}
partition "Клиент" {
  :Начало аренды, запрос открытия (UC-05);
}
partition "Телематика" {
  :Открыть замки, подтвердить статус;
}
partition "Клиент" {
  :Поездка: движение / ожидание;
  note right
    движение 8 руб/мин,
    ожидание 4 руб/мин,
    сутки 1500 руб
  end note
  :Завершение аренды, запрос закрытия (UC-06);
}
partition "Система" {
  :Проверка разрешённой зоны (UC-06a);
  note right
    Только Симферополь,
    только разрешённое место
  end note
  if (Зона разрешена?) then (да)
  else (нет)
    :Отказ: попросить перепарковаться;
    :Перепарковка клиентом, повторная проверка — пройдена;
    note right
      Цикл «отказ-перепарковка»
      показан свернуто:
      повторять до входа в зону
    end note
  endif
}
partition "Система" {
  :Расчёт стоимости поездки (UC-06b);
  :Списание через платёжный шлюз (UC-07);
  note right
    Карты не храним, всё через шлюз
  end note
  if (Оплата прошла?) then (да)
  else (нет)
    :Фиксация задолженности, повторная попытка;
  endif
}
partition "Телематика" {
  :Закрыть замки, зафиксировать гео;
}
partition "Система" {
  :Авто — свободно, история обновлена (UC-08);
}
stop

footer Задание №3 • Щербова А.А. • UC-02–07 • Vision v1.1
@enduml

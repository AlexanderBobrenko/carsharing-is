@startuml ad02-incident
' AD-02 Инцидент/ДТП — Задание №3, Щербова А.А.
' UC-09, UC-11, UC-12, UC-10, UC-13
title AD-02 — Фиксация и разбор инцидента / ДТП

skinparam shadowing false
skinparam activity {
  BackgroundColor white
  BorderColor #1a1a1a
  ArrowColor #333333
}
skinparam partition {
  BackgroundColor #f7f9fc
  BorderColor #1a1a1a
}
skinparam title {
  FontSize 16
  FontStyle bold
}

start
partition "Клиент" {
  :Фиксация инцидента / ДТП в приложении (UC-09);
  note right
    Фото, описание, гео и время
  end note
}
partition "Система" {
  :Создание обращения, привязка к аренде (UC-11);
}
partition "Оператор поддержки" {
  :Приём обращения в работу;
  if (Это ДТП?) then (да)
    :Запрос документов: фото, акты, ГИБДД;
    :Определение вины;
    if (Вина клиента?) then (да)
    else (нет)
      :Закрытие без начисления клиенту;
      note right
        Страховые — вне границ,
        система только фиксирует
      end note
      stop
    endif
  else (нет)
    :Квалификация: грязь / топливо / зона / ГИБДД;
  endif
  :Проверка доказательств и основания;
  note right
    Произвольные списания запрещены:
    у каждого штрафа основание
    и доказательства (Vision, прил. А)
  end note
  if (Нарушение подтверждено?) then (да)
  else (нет)
    :Отмена начисления, уведомление клиента;
    stop
  endif
}
partition "Система" {
  if (ДТП по вине клиента?) then (да)
    if (Есть исключения: опьянение / скрылся / не вызвал ГИБДД / передал управление?) then (да)
      :Расчёт: весь подтверждённый ущерб платит клиент;
      note right
        Прил. Б Vision:
        страховая отказала —
        платит клиент
      end note
    else (нет)
      :Расчёт доли: до 100 тыс — 15000 руб, свыше — 15%;
      note right
        Остальное — КАСКО/ОСАГО
      end note
    endif
  else (нет)
    :Расчёт по штрафам: грязь 3000, зона 3000, топливо 1000, ГИБДД + 500;
  endif
  :Начисление через платёжный шлюз;
}
if (Клиент оспаривает начисление? UC-10) then (да)
  partition "Оператор поддержки" {
    :Разбор спора UC-13: повторная проверка основания;
    if (Основание подтверждено?) then (да)
      :Подтверждение начисления;
    else (нет)
      :Отмена / корректировка начисления;
    endif
  }
else (нет)
endif
partition "Система" {
  :Закрытие обращения, запись в отчёты (UC-19);
}
stop

footer Задание №3 • Щербова А.А. • UC-09–13 • Vision v1.1, прил. А/Б
@enduml

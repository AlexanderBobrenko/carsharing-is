@startuml carsharing-usecase
' ============================================================
' ИС управления сервисом каршеринга — Диаграмма прецедентов
' Задание №2, ответственный: Иващенко Е.О. (ПИ-б-о-241)
' Версия 2: компактная (обобщение), отдельная роль по штрафам,
'          отмена брони — отдельный необязательный UC
' Источник: docs/01-vision-and-scope.md v1.1
' ============================================================
title ИС управления каршерингом — Диаграмма прецедентов (UseCase, №2)

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor white
  BorderColor #1a1a1a
  ArrowColor #1a1a1a
  FontSize 13
}
skinparam actor {
  BackgroundColor white
  BorderColor #1a1a1a
  ArrowColor #333333
  FontSize 14
}
skinparam rectangle {
  BackgroundColor #f7f9fc
  BorderColor #1a1a1a
}
skinparam title {
  FontSize 16
  FontStyle bold
}

' ---------- Акторы ----------
actor "Клиент" as A_Client
actor "Оператор\nподдержки" as A_Operator
actor "Специалист\nпо штрафам" as A_Fines
actor "Техник" as A_Tech
actor "Администратор" as A_Admin
actor "Сервис проверки\nдокументов\n<<внешняя система>>" as E_Docs << system >>
actor "Платёжный шлюз\n<<внешняя система>>" as E_Pay << system >>
actor "Телематика авто\n<<внешняя система>>" as E_Tele << system >>

' ---------- Граница системы ----------
rectangle "ИС управления каршерингом\n(мобильное приложение)" {

  ' === Клиент ===
  usecase "UC-01\nРегистрация\nи верификация" as UC01
  usecase "UC-02\nАренда автомобиля" as UC02
  usecase "UC-03\nОтмена брони" as UC03
  usecase "UC-04\nОплата поездки" as UC04
  usecase "UC-05\nИстория поездок\nи платежей" as UC05
  usecase "UC-06\nИнцидент / ДТП" as UC06
  usecase "UC-07\nОбращение\nв поддержку" as UC07

  ' === Оператор поддержки ===
  usecase "UC-08\nОбработка\nобращений" as UC08
  usecase "UC-08a\nРазбор\nинцидента / ДТП" as UC08a

  ' === Специалист по штрафам ===
  usecase "UC-09\nШтрафы\nи начисления" as UC09
  usecase "UC-09a\nНазначить\nштраф" as UC09a
  usecase "UC-09b\nРазбор спорных\nначислений" as UC09b
  usecase "UC-09c\nПравила штрафов\nи тарифы" as UC09c

  ' === Техник ===
  usecase "UC-10\nВыполнение заявок\nна обслуживание" as UC10
  usecase "UC-11\nСмена статуса\nавтомобиля" as UC11

  ' === Администратор ===
  usecase "UC-12\nУправление\nавтопарком" as UC12
  usecase "UC-13\nНазначение заявок\nтехникам" as UC13
  usecase "UC-14\nОтчёты: загрузка,\nвыручка, инциденты" as UC14
  usecase "UC-15\nУчётные записи\nсотрудников" as UC15
}

' ---------- Связи: Клиент ----------
A_Client --> UC01
A_Client --> UC02
A_Client --> UC03
A_Client --> UC04
A_Client --> UC05
A_Client --> UC06
A_Client --> UC07

' ---------- Связи: сотрудники ----------
' Актор связан с общим прецедентом; частные — через обобщение
A_Operator --> UC08
A_Fines --> UC09
A_Tech --> UC10
A_Tech --> UC11
A_Admin --> UC12
A_Admin --> UC13
A_Admin --> UC14
A_Admin --> UC15

' ---------- Обобщение: частные прецеденты — вид общего ----------
UC08a -up-|> UC08
UC09a -up-|> UC09
UC09b -up-|> UC09
UC09c -up-|> UC09

' ---------- include / extend ----------
UC03 ..> UC02 : <<extend>> : необязательно,\nпосле брони
UC06 ..> UC08 : <<include>>
UC13 ..> UC10 : <<include>>

' ---------- Внешние системы ----------
UC01 --> E_Docs : проверка паспорта + ВУ
UC02 --> E_Tele : гео, топливо, замки
UC04 --> E_Pay : списание / возврат
UC09 --> E_Pay : начисления
UC10 --> E_Tele : статус после ТО

footer Задание №2 • Иващенко Е.О. • v2: обобщение + роль по штрафам • Vision v1.1
@enduml
